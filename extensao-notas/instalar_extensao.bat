@echo off
cls
powershell -NoProfile -ExecutionPolicy Bypass -Command "& { [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; $Host.UI.RawUI.WindowTitle = 'SIGEduc Auto - Instalador da Extensao'; Clear-Host; Write-Host '======================================================================' -ForegroundColor Cyan; Write-Host '           SIGEduc Auto - Instalador da Extensao' -ForegroundColor Yellow; Write-Host '======================================================================' -ForegroundColor Cyan; Write-Host ''; Write-Host 'Ola, Professor(a)!' -ForegroundColor Green; Write-Host 'Este assistente vai preparar a extensao no seu navegador.'; Write-Host ''; $origem = '%~dp0'; $destino = [System.IO.Path]::Combine($env:LOCALAPPDATA, 'SIGEduc-Extensao'); Write-Host '[1/3] Configurando pasta segura permanente...' -ForegroundColor Cyan; if (-not (Test-Path $destino)) { New-Item -ItemType Directory -Path $destino -Force | Out-Null }; Copy-Item -Path (Join-Path $origem '*') -Destination $destino -Recurse -Force -Exclude 'tests','scripts','*.zip' -ErrorAction SilentlyContinue; Write-Host '      [OK] Extensao salva com sucesso em:' -ForegroundColor Green; Write-Host \"      $destino\" -ForegroundColor Gray; Write-Host ''; Write-Host '[2/3] Escolha o seu navegador principal:' -ForegroundColor Cyan; Write-Host '   [1] Google Chrome' -ForegroundColor White; Write-Host '   [2] Microsoft Edge' -ForegroundColor White; Write-Host '   [3] Brave Browser' -ForegroundColor White; Write-Host '   [4] Opera / Opera GX' -ForegroundColor White; Write-Host '   [5] Outro navegador Chromium' -ForegroundColor White; Write-Host ''; $op = Read-Host 'Digite o numero correspondente [1 a 5]'; Write-Host ''; Write-Host '[3/3] Abrindo pagina de extensoes e pasta de arquivos...' -ForegroundColor Cyan; switch ($op) { '1' { Start-Process 'chrome' 'chrome://extensions' -ErrorAction SilentlyContinue } '2' { Start-Process 'msedge' 'edge://extensions' -ErrorAction SilentlyContinue } '3' { Start-Process 'brave' 'brave://extensions' -ErrorAction SilentlyContinue } '4' { Start-Process 'opera' 'opera://extensions' -ErrorAction SilentlyContinue } default { Start-Process 'chrome://extensions' -ErrorAction SilentlyContinue } }; Start-Process 'explorer.exe' $destino; Write-Host ''; Write-Host '======================================================================' -ForegroundColor Green; Write-Host '                  PASSO A PASSO FINAL (SUPER FACIL):' -ForegroundColor Yellow; Write-Host '======================================================================' -ForegroundColor Green; Write-Host ''; Write-Host '1. Na janela de extensoes do navegador que acabou de abrir:' -ForegroundColor White; Write-Host '   - Ative a chave Modo do Desenvolvedor (no topo direito).' -ForegroundColor Yellow; Write-Host ''; Write-Host '2. Clique no botao Carregar sem compactacao (Load unpacked).' -ForegroundColor White; Write-Host ''; Write-Host '3. Selecione a pasta que acabou de abrir no Windows Explorer:' -ForegroundColor White; Write-Host \"   $destino\" -ForegroundColor Cyan; Write-Host ''; Write-Host '======================================================================' -ForegroundColor Green; Write-Host 'Pronto! O icone do SIGEduc Auto aparecera no topo do seu navegador!' -ForegroundColor Green; Write-Host 'Dica: Clique no icone de Quebra-cabeca da barra e fixe a extensao.' -ForegroundColor Gray; Write-Host '======================================================================' -ForegroundColor Green; Write-Host ''; Read-Host 'Pressione ENTER para concluir...' }"